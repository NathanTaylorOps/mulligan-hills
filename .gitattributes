# Normalise text; keep shell and GDScript LF everywhere (CI runs on Linux and macOS).
* text=auto eol=lf
*.sh text eol=lf
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.godot text eol=lf
*.cfg text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.bat text eol=crlf

# Large binaries go to Git LFS. Run `git lfs install` once per machine before the first
# commit that adds any of these. CI checkouts use lfs: true.
