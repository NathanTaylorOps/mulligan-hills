# Single source of truth for pinned tool versions. Sourced by tools/ci/lib.sh and
# read by workflows (cache keys use hashFiles of this file). Plain KEY=VALUE only.
GODOT_VERSION=4.7.2
GODOT_FLAVOR=stable
# Godot itself names the templates folder "<version>.<flavor>"
GODOT_TEMPLATE_DIRNAME=4.7.2.stable

# gdUnit4 (test framework). v6.x needs Godot 4.5+. Its compatibility table listed
# Godot up to 4.7.1 when checked; 4.7.2 is a bug-fix release. If CI shows a gdUnit4
# problem on 4.7.2, set GODOT_VERSION=4.7.1 and GODOT_TEMPLATE_DIRNAME=4.7.1.stable.
GDUNIT4_REPO=godot-gdunit-labs/gdUnit4
GDUNIT4_VERSION=v6.2.1

# Optional hard pins. Empty = verify only against the SHA512-SUMS.txt published with
# the release. After the first green run, copy the hashes printed in the download
# log here and every later run will refuse any other file.
GODOT_SHA512_LINUX=
GODOT_SHA512_MACOS=
GODOT_SHA512_WINDOWS=
GODOT_SHA512_TEMPLATES=

# Android toolchain (UNVERIFIED for 4.7.x: Godot prints the exact versions it wants
# if these are wrong; edit here). Space separated sdkmanager package ids.
JAVA_VERSION=17
ANDROID_TARGET_SDK=36
ANDROID_SDK_PACKAGES="platform-tools platforms;android-36 platforms;android-35 build-tools;36.0.0 build-tools;35.0.1 ndk;28.1.13356709"
