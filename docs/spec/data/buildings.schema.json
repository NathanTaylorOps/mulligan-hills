{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mulliganhills.example/buildings.schema.json",
  "title": "Mulligan Hills buildings data v1",
  "description": "10 buildings x 5 tiers. Loaded at start; balance changes need no code. Remote config may override costs within clamps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "status",
    "score_scale",
    "hole_cap",
    "hole_rules",
    "demo",
    "land",
    "rules",
    "buildings"
  ],
  "properties": {
    "schema": {
      "const": "mh.buildings"
    },
    "schema_version": {
      "const": 2
    },
    "status": {
      "type": "string"
    },
    "score_scale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max",
        "gate_basis"
      ],
      "properties": {
        "min": {
          "const": 0
        },
        "max": {
          "const": 100
        },
        "gate_basis": {
          "const": "average_hole_score"
        }
      }
    },
    "land": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "max_parcels",
        "golf_parcels",
        "facility_parcels",
        "homes_parcels",
        "start_parcels",
        "holes_per_two_golf_parcels",
        "home_slots_per_homes_parcel",
        "heavy_extra_parcels",
        "parcel_base_cost",
        "parcel_growth_pct",
        "grid",
        "parcels"
      ],
      "description": "DEC-056 working model: 16 parcels (12 golf, 2 facility, 2 homes) on a grid. Hole capacity = owned golf parcels * holes_per_two_golf_parcels / 2 (integer division).",
      "properties": {
        "unit": {
          "const": "parcel"
        },
        "max_parcels": {
          "const": 16
        },
        "golf_parcels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "facility_parcels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "homes_parcels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16
        },
        "start_parcels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "holes_per_two_golf_parcels": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "home_slots_per_homes_parcel": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "heavy_extra_parcels": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "parcel_base_cost": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 1000000
        },
        "parcel_growth_pct": {
          "type": "integer",
          "minimum": 100,
          "maximum": 200
        },
        "grid": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cols",
            "rows",
            "adjacency"
          ],
          "properties": {
            "cols": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "rows": {
              "type": "integer",
              "minimum": 1,
              "maximum": 16
            },
            "adjacency": {
              "const": "orthogonal"
            }
          }
        },
        "parcels": {
          "type": "array",
          "minItems": 16,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "col",
              "row",
              "start_owned"
            ],
            "properties": {
              "id": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              },
              "kind": {
                "enum": [
                  "golf",
                  "facility",
                  "homes"
                ]
              },
              "col": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              },
              "row": {
                "type": "integer",
                "minimum": 0,
                "maximum": 15
              },
              "start_owned": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "hole_cap": {
      "const": 18
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gates_persistent",
        "gates_checked_at_purchase_only",
        "note"
      ],
      "properties": {
        "gates_persistent": {
          "const": true
        },
        "gates_checked_at_purchase_only": {
          "const": false
        },
        "note": {
          "type": "string"
        }
      }
    },
    "buildings": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name_key",
          "desc_key",
          "land_class",
          "demo_max_tier",
          "tier3_specs",
          "tiers"
        ],
        "properties": {
          "id": {
            "enum": [
              "clubhouse",
              "pro_shop",
              "driving_range",
              "restaurant",
              "pool_spa",
              "cart_barn",
              "maintenance",
              "lodging",
              "homes",
              "landmark"
            ]
          },
          "name_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){1,4}$",
            "maxLength": 80
          },
          "desc_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){1,4}$",
            "maxLength": 80
          },
          "land_class": {
            "enum": [
              "light",
              "heavy"
            ]
          },
          "demo_max_tier": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "tier3_specs": {
            "type": "array",
            "minItems": 2,
            "maxItems": 2,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name_key"
              ],
              "properties": {
                "id": {
                  "enum": [
                    "a",
                    "b"
                  ]
                },
                "name_key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){1,4}$",
                  "maxLength": 80
                }
              }
            }
          },
          "tiers": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "tier",
                "name_key",
                "target_payback_days",
                "upkeep_per_day",
                "requires"
              ],
              "properties": {
                "tier": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "name_key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){1,4}$",
                  "maxLength": 80
                },
                "target_payback_days": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 365,
                  "description": "DEC-050: price = target_payback_days x added daily income (economy computes it). Placeholder curve 6/8/10/12/15."
                },
                "upkeep_per_day": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 1000000
                },
                "requires": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "min_holes",
                    "min_avg_hole_score",
                    "min_parcels_owned",
                    "min_members",
                    "specific",
                    "any_others",
                    "hosted_tournament"
                  ],
                  "properties": {
                    "min_holes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 18
                    },
                    "min_avg_hole_score": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "min_parcels_owned": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 16
                    },
                    "min_members": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10000
                    },
                    "specific": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "building",
                          "min_tier"
                        ],
                        "properties": {
                          "building": {
                            "enum": [
                              "clubhouse",
                              "pro_shop",
                              "driving_range",
                              "restaurant",
                              "pool_spa",
                              "cart_barn",
                              "maintenance",
                              "lodging",
                              "homes",
                              "landmark"
                            ]
                          },
                          "min_tier": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 5
                          }
                        }
                      },
                      "minItems": 0,
                      "maxItems": 5
                    },
                    "any_others": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "count",
                            "min_tier"
                          ],
                          "properties": {
                            "count": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 9
                            },
                            "min_tier": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 5
                            }
                          }
                        }
                      ]
                    },
                    "hosted_tournament": {
                      "oneOf": [
                        {
                          "type": "null"
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "min_level"
                          ],
                          "properties": {
                            "min_level": {
                              "enum": [
                                "local",
                                "regional",
                                "national",
                                "major"
                              ]
                            }
                          }
                        }
                      ]
                    }
                  }
                }
              }
            }
          },
          "home_slots": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "max_slots",
              "upgrade_mode"
            ],
            "description": "Homes only. Upgrading a tier replaces the standing homes with the newer bigger model; it never adds slots.",
            "properties": {
              "max_slots": {
                "type": "integer",
                "minimum": 1,
                "maximum": 12
              },
              "upgrade_mode": {
                "const": "replace"
              }
            }
          },
          "needs_parcel_kind": {
            "enum": [
              "facility",
              "homes"
            ],
            "description": "Optional. The building also needs at least one owned parcel of this kind (Homes need a homes parcel to hold their slots)."
          }
        }
      }
    },
    "hole_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dead_hole_score_below",
        "dead_holes_count_toward_gates"
      ],
      "description": "DEC-048: a hole scoring below dead_hole_score_below does not count toward the hole-count gates.",
      "properties": {
        "dead_hole_score_below": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "dead_holes_count_toward_gates": {
          "const": false
        }
      }
    },
    "demo": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_holes"
      ],
      "properties": {
        "max_holes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18
        }
      }
    }
  }
}
