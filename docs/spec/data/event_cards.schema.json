{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mulliganhills.example/event_cards.schema.json",
  "title": "Mulligan Hills event and decision cards v1",
  "description": "Random events and decision cards (storms, VIP visits, celebrity rounds, member complaints). Launch target 60 or more cards (workstream clock_events ships 65). All effects are integer and bounded; cards never touch the sim or rating engine, only cash, reputation, members, prestige and flags. Picked deterministically from the save RNG. Conditions (all optional, all must hold for a card to be eligible): min_day, min_avg_hole_score, min_members, min_tier and max_tier (club tier 0..5), seasons, requires_tags and forbids_tags (course state tags from the context), requires_flags and forbids_flags (save flags). Amount semantics: add_cash is scaled by remote config event_cash_scale_pct in code; weather_next_day amount is the forced rain_level 0..3 for the next day; golfer_flow_pct changes golfer arrivals by amount percent (-90..200) for `days` game days; set_flag and clear_flag need `flag`.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "cards"
  ],
  "properties": {
    "schema": {
      "const": "mh.event_cards"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "category",
          "weight",
          "min_day",
          "cooldown_days",
          "once",
          "title_key",
          "body_key",
          "choices"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,39}$"
          },
          "category": {
            "enum": [
              "weather",
              "vip",
              "celebrity",
              "member",
              "staff",
              "finance",
              "community"
            ]
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "min_day": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "cooldown_days": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "once": {
            "type": "boolean"
          },
          "min_avg_hole_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "min_members": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "title_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){1,4}$",
            "maxLength": 80
          },
          "body_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){1,4}$",
            "maxLength": 80
          },
          "choices": {
            "type": "array",
            "minItems": 2,
            "maxItems": 3,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "label_key",
                "outcome_key",
                "effects"
              ],
              "properties": {
                "id": {
                  "enum": [
                    "a",
                    "b",
                    "c"
                  ]
                },
                "label_key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){1,4}$",
                  "maxLength": 80
                },
                "outcome_key": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){1,4}$",
                  "maxLength": 80
                },
                "requires": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "min_cash": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 1000000000
                    },
                    "min_reputation": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 100000
                    }
                  }
                },
                "effects": {
                  "type": "array",
                  "minItems": 0,
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "op",
                      "amount"
                    ],
                    "properties": {
                      "op": {
                        "enum": [
                          "add_cash",
                          "add_reputation",
                          "add_members",
                          "add_prestige",
                          "set_flag",
                          "clear_flag",
                          "weather_next_day",
                          "golfer_flow_pct"
                        ]
                      },
                      "amount": {
                        "type": "integer",
                        "minimum": -100000000,
                        "maximum": 100000000
                      },
                      "flag": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]{1,39}$"
                      },
                      "days": {
                        "type": "integer",
                        "minimum": 1,
                        "maximum": 30
                      }
                    }
                  }
                }
              }
            }
          },
          "min_tier": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "max_tier": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "seasons": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": [
                "spring",
                "summer",
                "autumn",
                "winter"
              ]
            }
          },
          "requires_tags": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": [
                "has_pro_shop",
                "has_driving_range",
                "has_restaurant",
                "has_pool_spa",
                "has_lodging",
                "has_cart_barn",
                "has_landmark",
                "has_bunkers",
                "has_water_hazard",
                "recent_rain",
                "dry_spell",
                "busy",
                "quiet"
              ]
            }
          },
          "forbids_tags": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": [
                "has_pro_shop",
                "has_driving_range",
                "has_restaurant",
                "has_pool_spa",
                "has_lodging",
                "has_cart_barn",
                "has_landmark",
                "has_bunkers",
                "has_water_hazard",
                "recent_rain",
                "dry_spell",
                "busy",
                "quiet"
              ]
            }
          },
          "requires_flags": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,39}$"
            }
          },
          "forbids_flags": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{1,39}$"
            }
          }
        }
      }
    }
  }
}
