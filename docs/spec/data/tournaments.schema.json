{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.mulliganhills.example/tournaments.schema.json",
  "title": "Mulligan Hills tournament data v1",
  "description": "Tournament ladder, hosting prerequisites, spectator capacity by Clubhouse tier and prestige parameters. Every building requirement must be at tier 4 or lower (schema max 4) so tier 5 cannot gate itself.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "status",
    "spectator_capacity_by_clubhouse_tier",
    "prestige",
    "levels",
    "conditions",
    "evaluation",
    "scoring",
    "purse",
    "cancel_refund_pct",
    "default_pars"
  ],
  "properties": {
    "schema": {
      "const": "mh.tournaments"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "status": {
      "type": "string"
    },
    "spectator_capacity_by_clubhouse_tier": {
      "description": "Grandstands are a Clubhouse tier feature. Index 0 is tier 1.",
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100000
      }
    },
    "prestige": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_window_days",
        "sustained_min_days",
        "weights_permille",
        "facility_tier_cap",
        "facility_buildings"
      ],
      "properties": {
        "snapshot_window_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "sustained_min_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "facility_tier_cap": {
          "const": 4,
          "description": "Facilities score counts tiers up to 4 only, so prestige cannot depend on tier-5 buildings."
        },
        "weights_permille": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "course_score",
            "pace",
            "facilities",
            "field_satisfaction"
          ],
          "properties": {
            "course_score": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "pace": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "facilities": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            },
            "field_satisfaction": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1000
            }
          }
        },
        "facility_buildings": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": [
              "clubhouse",
              "pro_shop",
              "driving_range",
              "restaurant",
              "pool_spa",
              "cart_barn",
              "maintenance",
              "lodging",
              "homes",
              "landmark"
            ]
          },
          "description": "Buildings counted by the facilities part of prestige (each capped at facility_tier_cap)."
        }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "name_key",
          "desc_key",
          "entry",
          "field_size",
          "duration_days",
          "prep_days",
          "cooldown_days",
          "host_cost",
          "prestige_base",
          "reward",
          "revenue",
          "failure",
          "field"
        ],
        "properties": {
          "level": {
            "enum": [
              "local",
              "regional",
              "national",
              "major"
            ]
          },
          "name_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){1,4}$",
            "maxLength": 80
          },
          "desc_key": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+){1,4}$",
            "maxLength": 80
          },
          "entry": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "min_holes",
              "min_avg_hole_score",
              "min_pace_score",
              "buildings",
              "min_staff",
              "min_spectator_capacity"
            ],
            "properties": {
              "min_holes": {
                "type": "integer",
                "minimum": 1,
                "maximum": 18
              },
              "min_avg_hole_score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "min_pace_score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "buildings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "building",
                    "min_tier"
                  ],
                  "properties": {
                    "building": {
                      "enum": [
                        "clubhouse",
                        "pro_shop",
                        "driving_range",
                        "restaurant",
                        "pool_spa",
                        "cart_barn",
                        "maintenance",
                        "lodging",
                        "homes",
                        "landmark"
                      ]
                    },
                    "min_tier": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 4
                    }
                  }
                },
                "minItems": 0,
                "maxItems": 6
              },
              "min_staff": {
                "type": "integer",
                "minimum": 0,
                "maximum": 200
              },
              "min_spectator_capacity": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              }
            }
          },
          "field_size": {
            "type": "integer",
            "minimum": 4,
            "maximum": 64
          },
          "duration_days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "prep_days": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30
          },
          "cooldown_days": {
            "type": "integer",
            "minimum": 1,
            "maximum": 365
          },
          "host_cost": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          },
          "prestige_base": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000
          },
          "reward": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "cash",
              "reputation"
            ],
            "properties": {
              "cash": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000000
              },
              "reputation": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              }
            }
          },
          "revenue": {
            "description": "Income on a SUCCESSFUL event, whole dollars (DEC-065): entry_fee x field_size, plus tickets = ticket_price x spectator capacity of the Clubhouse tier x attendance_pct / 100 x duration_days. Paid on top of reward.cash (the sponsor payment). Failed events earn nothing.",
            "type": "object",
            "additionalProperties": false,
            "required": [
              "entry_fee",
              "ticket_price",
              "attendance_pct"
            ],
            "properties": {
              "entry_fee": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000000
              },
              "ticket_price": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              },
              "attendance_pct": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              }
            }
          },
          "failure": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "reputation_loss",
              "cash_loss",
              "cooldown_extra_days",
              "triggers"
            ],
            "properties": {
              "reputation_loss": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000
              },
              "cash_loss": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100000000
              },
              "cooldown_extra_days": {
                "type": "integer",
                "minimum": 0,
                "maximum": 365
              },
              "triggers": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "slow_pace",
                    "unfair_hole",
                    "bad_conditions",
                    "low_snapshot_score"
                  ]
                }
              }
            }
          },
          "field": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "skill_min",
              "skill_max"
            ],
            "properties": {
              "skill_min": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              },
              "skill_max": {
                "type": "integer",
                "minimum": 0,
                "maximum": 1000
              }
            }
          }
        }
      }
    },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "description": "Event conditions drawn from the event seed (weighted). A condition whose min_maintenance_tier exceeds the Maintenance tier triggers the bad_conditions failure.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "weight",
          "min_maintenance_tier",
          "strokes_x10",
          "satisfaction_penalty_pm"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{1,39}$"
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "min_maintenance_tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          },
          "strokes_x10": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          },
          "satisfaction_penalty_pm": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pace_fail_margin",
        "score_fail_margin",
        "unfair_fairness_below",
        "unfair_holes_to_fail",
        "unfair_satisfaction_penalty_pm"
      ],
      "properties": {
        "pace_fail_margin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "score_fail_margin": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "unfair_fairness_below": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "unfair_holes_to_fail": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18
        },
        "unfair_satisfaction_penalty_pm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        }
      }
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mid_skill_pm",
        "slope_x100",
        "difficulty_divisor",
        "hole_sd_x100",
        "min_over_hole",
        "max_over_hole"
      ],
      "description": "Field scoring model. Expected round over par in tenths of a stroke = (mid_skill_pm - skill) * slope_x100 // 100 (+ difficulty and condition terms).",
      "properties": {
        "mid_skill_pm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "slope_x100": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "difficulty_divisor": {
          "type": "integer",
          "minimum": 100,
          "maximum": 100000
        },
        "hole_sd_x100": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "min_over_hole": {
          "type": "integer",
          "minimum": -3,
          "maximum": 0
        },
        "max_over_hole": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        }
      }
    },
    "purse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pct_of_host_cost",
        "places_permille"
      ],
      "properties": {
        "pct_of_host_cost": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "places_permille": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "description": "Share of the purse by finishing place, permille, must sum to 1000."
        }
      }
    },
    "cancel_refund_pct": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "default_pars": {
      "type": "array",
      "minItems": 1,
      "maxItems": 18,
      "items": {
        "type": "integer",
        "minimum": 3,
        "maximum": 5
      }
    }
  }
}
